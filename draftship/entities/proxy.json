{
  "name": "Proxy",
  "type": "object",
  "properties": {
    "label": { "type": "string" },
    "host": { "type": "string" },
    "port": { "type": "number" },
    "username": { "type": "string" },
    "lastIp": { "type": "string" },
    "lastCountry": { "type": "string" },
    "lastIsp": { "type": "string" },
    "lastCity": { "type": "string" },
    "lastCheckedAt": { "type": "string" },
    "lastError": { "type": "string" }
  },
  "required": ["host", "port"],
  "rls": {
    "create": true,
    "read": { "created_by": "{{user.email}}" },
    "update": { "created_by": "{{user.email}}" },
    "delete": { "created_by": "{{user.email}}" }
  },
  "fls": {
    "username": {
      "read": { "created_by": "{{user.email}}" }
    }
  }
}
