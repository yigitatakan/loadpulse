{
  "name": "Bucket",
  "type": "object",
  "properties": {
    "runId": { "type": "string" },
    "clientKey": { "type": "string" },
    "second": { "type": "number" },
    "requests": { "type": "number" },
    "errors": { "type": "number" },
    "avgLatency": { "type": "number" },
    "statusCodes": { "type": "string" }
  },
  "required": ["runId", "second"],
  "rls": {
    "create": false,
    "read": { "created_by": "{{user.email}}" },
    "update": false,
    "delete": false
  }
}
