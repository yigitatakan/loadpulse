{
  "name": "Target",
  "type": "object",
  "properties": {
    "label": { "type": "string" },
    "url": { "type": "string" },
    "notes": { "type": "string" },
    "autoCheck": { "type": "boolean", "default": false },
    "lastChecked": { "type": "string" }
  },
  "required": ["url"],
  "rls": {
    "create": true,
    "read": { "created_by": "{{user.email}}" },
    "update": { "created_by": "{{user.email}}" },
    "delete": { "created_by": "{{user.email}}" }
  }
}
